# Copia este archivo a .env.local para desarrollo, o define estas variables
# en Cloudflare (Settings → Variables and secrets) para producción.
# Con al menos una, el formulario de contacto queda activo.

# Solo dígitos, con código de país (ej. 584141234567)
VITE_WHATSAPP_NUMBER=

# Correo de contacto (se usa si no hay WhatsApp)
VITE_CONTACT_EMAIL=
